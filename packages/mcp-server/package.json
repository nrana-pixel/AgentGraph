{
  "name": "@agentgraph/mcp-server",
  "version": "0.1.0",
  "description": "AgentGraph MCP server — exposes runtime tool discovery as MCP tools so agents avoid loading the whole tool registry into context",
  "type": "module",
  "bin": {
    "agentgraph-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "prebuild": "npm run build --workspace=@agentgraph/types",
    "build": "tsc",
    "pretypecheck": "npm run build --workspace=@agentgraph/types",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@agentgraph/types": "*",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
