# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://agentgraph:agentgraph@localhost:5432/agentgraph

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ──────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

# ─── Clerk (https://dashboard.clerk.com) ─────────────────────
# Get these from Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...   # From Clerk → Webhooks → Signing Secret
 CLERK_AUTHORIZED_PARTIES=https://app.agentgraph.dev,https://agentgraph.dev
  CLERK_JWT_AUDIENCE=...   # optional, only if your Clerk template emits aud

  
# Clerk redirect URLs (already set in docker-compose)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Next.js Dashboard ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Webhook secret encryption (optional) ───────────────────
# 32-byte key as 64 hex chars, e.g. `openssl rand -hex 32`.
# When set, webhook signing secrets are AES-256-GCM encrypted at rest.
# When unset, secrets are stored as plaintext (dev default).
WEBHOOK_ENCRYPTION_KEY=

# ─── External APIs (optional for Phase 2+) ───────────────────
GITHUB_TOKEN=ghp_...             # For sentiment fetcher (5,000 req/hr with auth)
STRIPE_SECRET_KEY=sk_test_...    # Phase 4: billing
STRIPE_WEBHOOK_SECRET=whsec_...  # Phase 4: Stripe webhook

# ─── Tool discovery (optional) ───────────────────────────────
# Semantic task→tool relevance. OpenAI-compatible /v1/embeddings endpoint.
# Unset = discovery falls back to keyword/FTS relevance (still works).
EMBEDDING_API_KEY=               # or reuse OPENAI_API_KEY
EMBEDDING_BASE_URL=              # default https://api.openai.com/v1
EMBEDDING_MODEL=                 # default text-embedding-3-small
# Catalog cold-start seeding (worker). Unset = MCP catalog sync is a no-op.
FIRECRAWL_API_KEY=               # https://firecrawl.dev
MCP_REGISTRY_URL=                # default https://registry.modelcontextprotocol.io/v0/servers
