# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://agentgraph:agentgraph@localhost:5432/agentgraph

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ──────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

# ─── Clerk (https://dashboard.clerk.com) ─────────────────────
# Get these from Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...   # From Clerk → Webhooks → Signing Secret

# Clerk redirect URLs (already set in docker-compose)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Next.js Dashboard ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── External APIs (optional for Phase 2+) ───────────────────
GITHUB_TOKEN=ghp_...             # For sentiment fetcher (5,000 req/hr with auth)
STRIPE_SECRET_KEY=sk_test_...    # Phase 4: billing
STRIPE_WEBHOOK_SECRET=whsec_...  # Phase 4: Stripe webhook
